pipeline {
    agent any

    parameters {
        // Creates a dropdown selection in the Jenkins UI
        choice(
            name: 'environment', 
            choices: ['qa', 'uat'], 
            description: 'Select the environment to run the scripts.'
        )
        choice(
            name: 'test_suite', 
            choices: ['@smoke', '@regression'], 
            description: 'Select the test tag execution scope.'
        )
        choice(
            name: 'browser', 
            choices: ['chromium', 'edge'], 
            description: 'Select the desired browser to execute.'
        )
    }

    tools {
        nodejs 'NodeJS' 
    }

    environment {
        PLAYWRIGHT_BROWSERS_PATH = "${WORKSPACE}/.cache/ms-playwright"

        // // Non-sensitive configuration variables
        // TEST_URL = 'https://example.com'
        // TEST_USER = 'jenkins_automation_user'

        // // Securely pulling sensitive passwords from Jenkins Credentials Provider
        // TEST_PASSWORD = credentials('TEST_PASSWORD')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'npm ci'
                    } else {
                        bat 'npm ci'
                    }
                }
            }
        }

        stage('Install Playwright') {
            steps {
                script {
                    def browserToInstall = params.browser == 'edge' ? 'msedge' : params.browser

                    if (isUnix()) {
                        sh "npx playwright install --with-deps ${browserToInstall}"
                    } else {
                        bat "npx playwright install --with-deps ${browserToInstall}"
                    }
                }
            }
        }

        stage('Run Playwright Tests') {
            steps {
                script {
                    try {
                        if (isUnix()) {
                            sh "npm run test:${params.environment} -- --grep '${params.test_suite}' --project=${params.browser} --reporter=list,html"
                        } else {
                            bat "npm run test:${params.environment} -- --grep \"${params.test_suite}\" --project=${params.browser} --reporter=list,html"
                        }
                    } catch (err) {
                        currentBuild.result = 'FAILURE'
                        throw err
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (fileExists('playwright-report/index.html')) {
                    if (isUnix()) {
                        sh '''
                            mkdir -p reports/playwright
                            cp -r playwright-report/. reports/playwright/
                        '''
                    } else {
                        bat '''
                            if not exist reports\\playwright mkdir reports\\playwright
                            xcopy /E /I /Y playwright-report reports\\playwright\\ >nul
                        '''
                    }

                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'reports/playwright',
                        reportFiles: 'index.html',
                        reportName: 'Playwright_HTML_Report',
                        reportTitles: 'Playwright Test Execution Report'
                    ])

                    archiveArtifacts artifacts: 'reports/playwright/**', fingerprint: true, allowEmptyArchive: true
                    echo 'Playwright report published from reports/playwright.'
                } else {
                    echo 'Playwright HTML report was not generated. Check the test run output and report folder.'
                }
            }
        }
    }
}